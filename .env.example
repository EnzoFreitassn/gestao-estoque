# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
#
# DATABASE_URL = conexão de runtime (em produção serverless, use a POOLED).
# DIRECT_URL   = conexão direta usada pelas migrations.
#
# Dev local (docker-compose): ambas apontam para o mesmo banco.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/estoque?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/estoque?schema=public"

# Produção com Neon (exemplo):
#   DATABASE_URL = string "Pooled connection"  (host com "-pooler")
#   DIRECT_URL   = string "Direct connection"  (sem "-pooler")
#   Ambas terminam com ?sslmode=require
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Gere um segredo com:  npx auth secret   (ou: openssl rand -base64 32)
# ---------------------------------------------------------------------------
AUTH_SECRET="troque-por-um-segredo-forte-de-32-bytes-em-base64"

# Confia no host da requisição (necessário atrás de proxy/Docker; ok em dev).
AUTH_TRUST_HOST="true"
